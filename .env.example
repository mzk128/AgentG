OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# 仅用于本地 Web 开发；稳定运行和 Docker 建议保持 false
WEB_RELOAD=false

# Reviewer 总审查轮数（含首次审查）；2 表示最多一轮定向返工
MAX_REVIEW_ROUNDS=2

# 资源终止策略（Token 暂不计入）
MAX_TOOL_ROUNDS=40
MAX_TOOL_CALLS=120
MAX_CONSECUTIVE_ERRORS=20
MAX_RUN_SECONDS=12000
# 单次模型 HTTP 请求硬超时，避免上游无响应时长期停在上一阶段
MODEL_REQUEST_TIMEOUT_SECONDS=180
# 一次模型调用或一次实际工具执行各消耗 1 个动作单位
TOTAL_ACTION_BUDGET=4000

# 上下文容量管理（保守 UTF-8 字节估算；320000 对中英混合内容约为 8～10 万模型 Token）
# 配置的模型服务必须支持相应窗口；这不是累计 Token 费用终止策略
CONTEXT_MAX_TOKENS=320000
CONTEXT_OUTPUT_RESERVE=16000
CONVERSATION_MAX_TOKENS=4000
SUMMARY_MAX_TOKENS=800
MEMORY_RECENT_TURNS=6
UPSTREAM_MAX_TOKENS=3000

# 工具输出上限和 Python 子进程硬超时
TOOL_OUTPUT_MAX_CHARS=12000
PYTHON_TIMEOUT_SECONDS=15

# 长期记忆为显式启用功能；SQLite 保存记忆，Redis 仍保存 checkpoint
LONG_TERM_MEMORY_ENABLED=false
# 相对路径以项目应用根目录解析，不随终端 cwd 或任务工作目录改变
MEMORY_DB_PATH=.agentg/memory/long_term.sqlite3
# SQLite 锁等待上限（毫秒，1～60000）
MEMORY_DB_BUSY_TIMEOUT_MS=5000
# 宿主稳定身份；项目 ID 手工指定，不从任务、标题或工作目录推导
MEMORY_USER_ID=local-user
MEMORY_PROJECT_ID=
MEMORY_TOP_K=5
# 独立记忆输入预算，沿用保守 UTF-8 字节单位（不是真实 Token）
MEMORY_MAX_TOKENS=4000
# 每个已授权 namespace 的有界扫描上限；不使用 FTS/向量服务
MEMORY_SCAN_LIMIT=200
# 确定性提取最终公开交付为候选；默认关闭，不调用额外模型
MEMORY_AUTO_EXTRACT=false
